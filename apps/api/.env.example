# Keep in sync with src/config/env.ts (a test fails if a variable is missing here).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://webhook:webhook@localhost:5433/webhooks
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
DASHBOARD_ORIGIN=http://localhost:3000
# 64 random hex chars: openssl rand -hex 32
SESSION_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
# Optional: emails are logged if absent
RESEND_API_KEY=
# Optional: alerts are logged if absent
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
LOG_LEVEL=info
# Optional: sender for endpoint-disabled and password-reset emails
EMAIL_FROM="Webhook <onboarding@resend.dev>"
# Local development only (refused in production): allow http, any port and private IPs as webhook targets
ALLOW_INSECURE_WEBHOOK_TARGETS=false
