{
  "name": "@webhook/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "openapi": "pnpm --filter @webhook/api openapi ../docs/public/openapi.json",
    "predev": "pnpm openapi",
    "dev": "next dev --port 3100",
    "prebuild": "pnpm openapi",
    "build": "next build",
    "start": "serve out -l 3100",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.18",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.18",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@scalar/api-reference-react": "^0.9.77"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
