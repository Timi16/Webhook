{
  "name": "webhook",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm --filter @webhook/shared build",
    "build": "pnpm --filter @webhook/shared --filter @webhook/api build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @webhook/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @webhook/shared build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:docs": "pnpm --filter @webhook/shared build && pnpm --filter @webhook/api exec prisma generate && pnpm --filter @webhook/docs build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
